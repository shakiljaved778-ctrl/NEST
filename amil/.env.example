# AMIL local configuration. Copy to .env. All values are for LOCAL DEMO use only.

# PostgreSQL 16 and Redis 7 (docker compose up -d postgres redis)
DATABASE_URL=postgresql://amil:amil@localhost:5432/amil?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Apps
NEXT_PUBLIC_API_URL=http://localhost:4000

# Seed: ISO timestamp the synthetic dataset is anchored to (default: now). See docs/DECISIONS.md D-002.
# SEED_NOW=2026-09-30T09:00:00Z

# Model gateway (Phase 3). Optional: without a key the gateway uses the offline `mock` provider.
# ANTHROPIC_API_KEY=

# Integration tests (packages/db): a separate, disposable database. Tests are skipped when unset.
TEST_DATABASE_URL=postgresql://amil:amil@localhost:5432/amil_test?schema=public
