// NEST Solutions — production PostgreSQL schema (Prisma).
// The demo app runs on an in-memory store (lib/store.ts); this schema is the
// production target from the technical blueprint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
  OPERATIONS
}

enum Language {
  EN
  AR
  HI
  UR
  ML
  TL
}

enum BookingStatus {
  PENDING_MATCH
  MATCHED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PRE_AUTHORIZED
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum DocumentStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ComplaintCategory {
  LATE_ARRIVAL
  POOR_QUALITY
  DAMAGE_CLAIM
  SAFETY_CONCERN
  PAYMENT_ISSUE
  PROVIDER_BEHAVIOR
  INCOMPLETE_JOB
  OTHER
}

model User {
  id                String              @id @default(cuid())
  phone             String              @unique
  email             String?
  name              String
  role              Role                @default(CUSTOMER)
  preferredLanguage Language            @default(EN)
  status            String              @default("active")
  createdAt         DateTime            @default(now())
  addresses         Address[]
  bookings          Booking[]           @relation("CustomerBookings")
  provider          Provider?
  walletTransactions WalletTransaction[]
  notifications     Notification[]
  familyMembers     FamilyMember[]
  subscriptions     Subscription[]
}

model FamilyMember {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  name     String
  relation String
  notes    String?
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  zone      String
  street    String?
  building  String?
  apartment String?
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)
}

model Provider {
  id                 String               @id @default(cuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id])
  status             String               @default("onboarding")
  verificationStatus DocumentStatus       @default(PENDING)
  gender             String?
  rating             Float                @default(0)
  jobsDone           Int                  @default(0)
  completionRate     Float                @default(0)
  responseMinutes    Int                  @default(15)
  yearsExperience    Int                  @default(0)
  payoutAccount      String?
  documents          ProviderDocument[]
  skills             ProviderSkill[]
  availability       ProviderAvailability[]
  bookings           Booking[]            @relation("ProviderBookings")
}

model ProviderDocument {
  id         String         @id @default(cuid())
  providerId String
  provider   Provider       @relation(fields: [providerId], references: [id])
  type       String // qid, work_permit, police_clearance, certification
  fileUrl    String // S3 key, KMS-encrypted bucket
  status     DocumentStatus @default(PENDING)
  expiryDate DateTime?
  createdAt  DateTime       @default(now())
}

model ProviderSkill {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  level      String   @default("intermediate")
  certified  Boolean  @default(false)
}

model ProviderAvailability {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  dayOfWeek  Int // 0-6
  startTime  String // "08:00"
  endTime    String // "20:00"
  zone       String
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String
  nameAr    String
  icon      String?
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id               String          @id @default(cuid())
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  slug             String          @unique
  name             String
  nameAr           String
  tagline          String?
  active           Boolean         @default(true)
  genderPreference Boolean         @default(false)
  safetyNote       String?
  packages         Package[]
  addons           Addon[]
  providerSkills   ProviderSkill[]
}

model Package {
  id           String        @id @default(cuid())
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  name         String
  nameAr       String
  description  String?
  basePrice    Decimal       @db.Decimal(10, 2)
  durationMin  Int           @default(60)
  popular      Boolean       @default(false)
  bookingItems BookingItem[]
}

model Addon {
  id           String        @id @default(cuid())
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id])
  name         String
  nameAr       String
  price        Decimal       @db.Decimal(10, 2)
  durationMin  Int           @default(0)
  bookingItems BookingItem[]
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique // NB-xxxx
  customerId    String
  customer      User          @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId    String?
  provider      Provider?     @relation("ProviderBookings", fields: [providerId], references: [id])
  status        BookingStatus @default(PENDING_MATCH)
  zone          String
  address       String
  scheduledDate DateTime
  slot          String
  urgent        Boolean       @default(false)
  subtotal      Decimal       @db.Decimal(10, 2)
  surcharge     Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  couponCode    String?
  language      Language      @default(EN)
  rating        Int?
  reviewComment String?
  createdAt     DateTime      @default(now())
  items         BookingItem[]
  payment       Payment?
  complaints    Complaint[]
  chatThread    ChatThread?
  checklist     ChecklistItem[]
  photos        JobPhoto[]
}

model BookingItem {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])
  addonId   String?
  addon     Addon?   @relation(fields: [addonId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
}

model ChecklistItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  label     String
  done      Boolean @default(false)
}

model JobPhoto {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  kind      String // before | after
  fileUrl   String
  createdAt DateTime @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  method      String // card, apple_pay, wallet, cash
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  pspRef      String? // tokenized reference at QCB-licensed PSP
  invoiceUrl  String? // VAT-ready e-invoice
  createdAt   DateTime      @default(now())
  refunds     Refund[]
}

model Refund {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Complaint {
  id              String            @id @default(cuid())
  bookingId       String
  booking         Booking           @relation(fields: [bookingId], references: [id])
  category        ComplaintCategory @default(OTHER)
  priority        String            @default("medium")
  refundRisk      Float             @default(0)
  humanEscalation Boolean           @default(false)
  text            String
  status          String            @default("open")
  assignedTo      String?
  createdAt       DateTime          @default(now())
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // percent | fixed
  value      Decimal   @db.Decimal(10, 2)
  label      String?
  usageLimit Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  active     Boolean   @default(true)
}

model Subscription {
  id          String    @id @default(cuid())
  customerId  String
  customer    User      @relation(fields: [customerId], references: [id])
  planCode    String // nest_plus_essential, nest_plus_family, villa_amc
  status      String    @default("active")
  renewalDate DateTime?
  createdAt   DateTime  @default(now())
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  type      String // credit, debit, cashback, refund
  reference String?
  createdAt DateTime @default(now())
}

model ChatThread {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id])
  messages   ChatMessage[]
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id])
  senderId       String
  body           String
  language       Language   @default(EN)
  translatedBody String? // AI translation layer output
  createdAt      DateTime   @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String // push, sms, email, in_app
  title     String
  body      String
  status    String   @default("queued")
  createdAt DateTime @default(now())
}

model AiRecommendation {
  id         String   @id @default(cuid())
  userId     String?
  context    String // booking_assistant, matching, pricing, complaint
  input      String
  output     String
  model      String
  confidence Float?
  createdAt  DateTime @default(now())
}

model FraudFlag {
  id         String   @id @default(cuid())
  entityType String // customer, provider, booking, coupon
  entityId   String
  reason     String
  score      Float
  status     String   @default("open")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
