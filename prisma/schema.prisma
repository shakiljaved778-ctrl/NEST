// Voyara data model (§3). Provider is SQLite for zero-setup dev; swap to
// "postgresql" for production (DATABASE_URL drives it). Array/jsonb fields are
// modeled as Json so the schema runs on both engines without change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  homeCurrency String    @default("USD")
  autonomyTier String    @default("ASK") // WATCH | ASK | ACT
  actCapMinor  Int       @default(20000)
  createdAt    DateTime  @default(now())

  tasteGraph  TasteGraph?
  trips       Trip[]
  wallets     WalletAccount[]
  freezes     FreezeContract[]
  memberships Membership[]
}

model TasteGraph {
  userId    String   @id
  prefs     Json // airlines, seat, hotel style, neighborhoods, pace, dietary, budget bands
  embedding Json? // vector, stored as Json array
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Trip {
  id           String   @id @default(cuid())
  userId       String
  status       String   @default("DRAFT") // DRAFT|ASSEMBLED|BOOKED|LIVE|COMPLETED|CANCELLED
  intentText   String
  origin       String?
  destinations Json // string[]
  dateRange    Json // { checkIn, checkOut }
  partySize    Int      @default(1)
  budgetCapMinor Int?
  createdAt    DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id])
  options        TripOption[]
  bookings       Booking[]
  guardianEvents GuardianEvent[]
}

model TripOption {
  id               String   @id @default(cuid())
  tripId           String
  rank             Int // 1=primary, 2-3=alternates
  fitScore         Float
  totalPriceMinor  Int
  currency         String   @default("USD")
  verdict          String // BUY | WAIT
  verdictConfidence Float
  forecastCurve    Json
  expiresAt        DateTime

  trip     Trip      @relation(fields: [tripId], references: [id])
  segments Segment[]
}

model Segment {
  id           String  @id @default(cuid())
  tripOptionId String
  kind         String // FLIGHT | HOTEL | GROUND
  supplierRef  String
  offerPayload Json
  holdExpiry   DateTime?
  status       String  @default("PROPOSED")

  option TripOption @relation(fields: [tripOptionId], references: [id])
}

model Booking {
  id            String   @id @default(cuid())
  tripId        String
  sagaId        String
  status        String // PENDING|HOLDING|CHARGED|CONFIRMED|FAILED|COMPENSATED
  pnrRefs       Json
  totalChargedMinor Int
  walletAppliedMinor Int  @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

model WalletAccount {
  id           String @id @default(cuid())
  userId       String
  currency     String @default("USD")
  balanceMinor Int    @default(0) // DERIVED cache only; source of truth is LedgerPosting

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, currency])
}

model LedgerPosting {
  id         String   @id @default(cuid())
  txId       String
  accountId  String
  amountMinor Int
  direction  String // DEBIT | CREDIT
  currency   String   @default("USD")
  memo       String
  createdAt  DateTime @default(now())

  @@index([txId])
  @@index([accountId])
}

model FreezeContract {
  id              String   @id @default(cuid())
  userId          String
  offerHash       String
  lockedPriceMinor Int
  feeMinor        Int
  currency        String   @default("USD")
  expiresAt       DateTime
  exposureCapMinor Int
  status          String   @default("ACTIVE") // ACTIVE | EXERCISED | EXPIRED

  user User @relation(fields: [userId], references: [id])
}

model GuardianEvent {
  id          String   @id @default(cuid())
  tripId      String
  kind        String // DELAY|CANCEL|SCHEDULE_CHANGE|PRICE_DROP|GHOST_INVENTORY
  payload     Json
  detectedAt  DateTime @default(now())
  remediation String   @default("PROPOSED") // PROPOSED|AUTO_EXECUTED|DECLINED
  savingsMinor Int     @default(0)

  trip Trip @relation(fields: [tripId], references: [id])
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  plan     String   @default("VOYARA_PLUS")
  priceMinor Int    @default(9900) // $99/yr
  renewsAt DateTime
  perks    Json

  user User @relation(fields: [userId], references: [id])
}

model ApiPartner {
  id               String @id @default(cuid())
  name             String
  scopes           Json // string[]
  perBookingFeeMinor Int
  rateLimit        Int    @default(60)
}

// Append-only. In production, REVOKE UPDATE/DELETE on this table.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // USER | AGENT | PARTNER_AGENT | SYSTEM
  action     String
  toolName   String
  inputHash  String
  outputHash String?
  tripId     String?
  createdAt  DateTime @default(now())

  @@index([tripId])
  @@index([createdAt])
}
