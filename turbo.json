{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "API_PORT",
    "API_HOST",
    "LOG_LEVEL",
    "NEXT_PUBLIC_*",
    "SEED_NOW",
    "ANTHROPIC_API_KEY"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "@amil/db#db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["@amil/db#db:generate"]
    },
    "lint": {
      "dependsOn": ["@amil/db#db:generate"]
    },
    "test": {
      "dependsOn": ["@amil/db#db:generate"]
    },
    "dev": {
      "dependsOn": ["@amil/db#db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
