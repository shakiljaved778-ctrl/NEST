{
  "name": "@amil/demo-bank",
  "version": "0.1.0",
  "private": true,
  "description": "Doha Demo Bank (fictional): phone-framed mobile banking app that embeds AMIL.",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "next build",
    "start": "dotenv -e ../../.env -- next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "dotenv -e ../../.env -- playwright test"
  },
  "dependencies": {
    "@amil/db": "workspace:*",
    "@amil/i18n": "workspace:*",
    "@amil/sdk": "workspace:*",
    "@amil/ui": "workspace:*",
    "@amil/widget": "workspace:*",
    "@prisma/client": "~6.19.3",
    "lucide-react": "^1.49.0",
    "next": "~15.5.0",
    "next-intl": "^4.14.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^8.0.0",
    "tailwindcss": "^4.1.0"
  }
}
