{
  "name": "@amil/api",
  "version": "0.1.0",
  "private": true,
  "description": "AMIL API (Fastify). Insight endpoints arrive in Phase 3.",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@amil/db": "workspace:*",
    "@amil/gateway": "workspace:*",
    "@amil/i18n": "workspace:*",
    "@amil/rule-packs": "workspace:*",
    "@amil/rules-engine": "workspace:*",
    "@amil/sdk": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "~6.19.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.12",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
