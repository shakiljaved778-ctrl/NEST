{
  "name": "@amil/api",
  "version": "0.1.0",
  "private": true,
  "description": "AMIL API (Fastify) and proactive worker (BullMQ).",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run",
    "worker": "dotenv -e ../../.env -- tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "proactive:run": "dotenv -e ../../.env -- tsx src/scripts/proactive-run.ts",
    "demo:traffic": "dotenv -e ../../.env -- tsx src/scripts/demo-traffic.ts"
  },
  "dependencies": {
    "@amil/db": "workspace:*",
    "@amil/gateway": "workspace:*",
    "@amil/i18n": "workspace:*",
    "@amil/rule-packs": "workspace:*",
    "@amil/rules-engine": "workspace:*",
    "@amil/sdk": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "~6.19.0",
    "bullmq": "^5.81.5",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "jose": "^6.2.12",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
