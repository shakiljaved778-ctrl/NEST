{
  "name": "amil",
  "private": true,
  "description": "AMIL AI: pre-decision intelligence layer for retail banking (demo MVP).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @amil/db db:generate",
    "db:migrate": "pnpm --filter @amil/db db:migrate",
    "db:migrate:dev": "pnpm --filter @amil/db db:migrate:dev",
    "db:seed": "pnpm --filter @amil/db db:seed",
    "db:reset": "pnpm --filter @amil/db db:reset",
    "audit:verify": "pnpm --filter @amil/db audit:verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^15.5.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.0"
  }
}
