# ── Voyara environment ─────────────────────────────────────────────
# Everything runs with ZERO external keys using the mock adapters.
# Fill these only when wiring real suppliers / payments / LLM.

# Database (Prisma). Defaults to a local SQLite file for zero-setup dev.
DATABASE_URL="file:./dev.db"

# LLM planner. Provider is swappable behind the Planner interface.
# Leave empty to use the built-in deterministic HeuristicPlanner (no key needed).
PLANNER_PROVIDER="heuristic"          # heuristic | anthropic
ANTHROPIC_API_KEY=""

# Inventory adapters. "mock" needs no keys and ships rich fixtures.
LODGING_ADAPTER="mock"                # mock | hotelbeds | rapid
AIR_ADAPTER="mock"                    # mock | duffel
DUFFEL_API_KEY=""
HOTELBEDS_API_KEY=""

# Payments — Stripe TEST mode only. Card data is tokenized, never stored.
STRIPE_SECRET_KEY=""                  # sk_test_...
STRIPE_PUBLISHABLE_KEY=""             # pk_test_...
STRIPE_WEBHOOK_SECRET=""

# Guardian daemon queue (BullMQ + Redis). Optional in Phase 0.
REDIS_URL="redis://localhost:6379"

# Autonomy money cap (minor units) for ACT tier auto-remediation.
AUTONOMY_DEFAULT_ACT_CAP_MINOR="20000"
