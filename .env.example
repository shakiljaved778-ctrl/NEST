# ------------------------------------------------------------------
# Qatar Market Dashboard — environment variables
# Copy to .env.local for development. The demo runs with ZERO of these
# set (mock data + localStorage auth); they only matter when connecting
# real providers / a database.
# ------------------------------------------------------------------

# --- Market data provider ---------------------------------------------------
# mock (default) | real
MARKET_DATA_PROVIDER=mock
# Generic equities/fundamentals provider (FMP / Polygon / Alpha Vantage)
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=https://financialmodelingprep.com/api/v3
# Qatar-specific feeds
QSE_API_KEY=
QCB_API_KEY=

# --- Feature flags ----------------------------------------------------------
# Force-enable premium features in a preview build (optional)
NEXT_PUBLIC_FORCE_PREMIUM=false

# --- Database (Prisma) ------------------------------------------------------
# Neon / Supabase / any Postgres. Used by prisma/market.schema.prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/qatar_markets

# --- Cache (Redis / Upstash) ------------------------------------------------
# When unset, an in-memory cache is used (see services/market/cache.ts).
REDIS_URL=

# --- Auth (NextAuth) --------------------------------------------------------
NEXTAUTH_URL=http://localhost:4200
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Billing (Stripe / Paddle) ----------------------------------------------
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
