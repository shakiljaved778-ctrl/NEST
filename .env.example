# AMIL local configuration. Copy to .env. All values are for LOCAL DEMO use only.

# PostgreSQL 16 and Redis 7 (docker compose up -d postgres redis)
DATABASE_URL=postgresql://amil:amil@localhost:5432/amil?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Bank-to-AMIL HMAC credentials: keyId:secret:bankId[:purpose] (comma-separated; purpose bank|console,
# default bank). DEMO VALUES ONLY.
AMIL_API_KEYS=ddb-demo-key:demo-only-secret-change-me-0123456789abcdef:bank_ddb,ddb-console-key:demo-only-console-secret-change-me-012345678:bank_ddb:console
# Signs 15-minute widget session tokens. DEMO VALUE ONLY (min 32 chars).
SESSION_SECRET=demo-only-session-secret-change-me-0123456789
# Keys the customer-ref hash in the audit trail. DEMO VALUE ONLY (min 32 chars).
AUDIT_HASH_SECRET=demo-only-audit-hash-secret-change-me-0123456
# PII columns are encrypted at rest with AES-256-GCM (D-066): "keyId:<base64 32 bytes>", newest
# first; older keys still decrypt. Demo-only key; use your KMS (envelope keys) in a deployment.
PII_ENCRYPTION_KEYS=demo1:ZGVtby1vbmx5LXBpaS1rZXktY2hhbmdlLW1lLTAwMDE=
# Browser origins allowed to call widget endpoints
WIDGET_ORIGINS=http://localhost:3000

# Apps
NEXT_PUBLIC_API_URL=http://localhost:4000
# Demo bank backend -> AMIL (server-side only; must match an entry in AMIL_API_KEYS)
AMIL_API_URL=http://localhost:4000
AMIL_DEMO_KEY_ID=ddb-demo-key
AMIL_DEMO_KEY_SECRET=demo-only-secret-change-me-0123456789abcdef
# Console backend -> AMIL: a key that can only sign staff into the console (purpose "console", D-067)
AMIL_CONSOLE_KEY_ID=ddb-console-key
AMIL_CONSOLE_KEY_SECRET=demo-only-console-secret-change-me-012345678
# Console session cookie is Secure in production builds (fine on http://localhost). Set to 1 only
# to try a production build over plain http on another host name.
# CONSOLE_INSECURE_COOKIE=1

# Seed: ISO timestamp the synthetic dataset is anchored to (default: now). See docs/DECISIONS.md D-002.
# SEED_NOW=2026-09-30T09:00:00Z

# Model gateway. Optional: without a key the gateway uses the offline `mock` provider,
# which serves the bank-approved wording, so the demo works fully offline.
# ANTHROPIC_API_KEY=
# AMIL_ANTHROPIC_MODEL=claude-opus-5-5
# Wording deadline in ms; beyond it the approved template is served (section 7).
# MODEL_TIMEOUT_MS=1500
# in_country mode: an OpenAI-compatible endpoint inside the bank's perimeter.
# IN_COUNTRY_MODEL_URL=http://llm.bank.internal/v1
# IN_COUNTRY_MODEL=local-model
# IN_COUNTRY_API_KEY=

# Integration tests (packages/db): a separate, disposable database. Tests are skipped when unset.
TEST_DATABASE_URL=postgresql://amil:amil@localhost:5432/amil_test?schema=public
