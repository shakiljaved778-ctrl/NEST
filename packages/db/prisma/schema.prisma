// AMIL AI data model. See docs/data-model.md for the narrative version.
//
// Conventions:
//   - Multi-bank capable: every tenant-owned root row carries bankId. Deployed single-tenant.
//   - Money: Decimal(18,2) QAR. Rates: Decimal(9,4) annual PERCENT (36.0000 = 36% p.a.).
//   - Money and rates inside Json rule columns are decimal STRINGS, never JSON numbers.
//   - PII lives only in: Customer.displayName/displayNameAr/phone/email, Account.number/iban,
//     Card.pan. These are never passed to the model gateway. They are encrypted at the
//     application level from Phase 8 onwards.
//   - insight_event and customer_response are append-only (enforced by DB triggers in the
//     migration). Hash chain: InsightEvent.prevHash -> hash.
//   - All product values are SYNTHETIC demo data. Doha Demo Bank is fictional.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------

enum Locale {
  en
  ar
}

enum DigitStyle {
  latn
  arab
}

enum ModelMode {
  redacted
  in_country
  off
}

enum Variant {
  conventional
  islamic
}

enum AccountKind {
  current
  savings
}

enum AccountStatus {
  active
  dormant
  restricted
  closed
}

enum CardTier {
  classic
  gold
  platinum
  signature
}

enum CardStatus {
  active
  blocked
  closed
}

enum FinanceType {
  conventional
  murabaha
  ijara
}

enum ProductStatus {
  active
  settled
  closed
}

enum DepositStatus {
  active
  matured
  broken
}

enum TxnDirection {
  debit
  credit
}

enum TxnType {
  purchase
  payment
  fee
  salary
  transfer_in
  transfer_out
  cash_withdrawal
  interest_charge
  profit_charge
  profit_credit
  refund
  standing_order
  instalment
}

enum RulePackStatus {
  draft
  active
  retired
}

enum TemplateStatus {
  draft
  /// Submitted by product, waiting for compliance
  in_review
  /// Islamic copy approved by compliance, waiting for the Sharia reviewer
  compliance_approved
  approved
  sharia_approved
  retired
}

enum Severity {
  info
  caution
  critical
}

enum ValidatorResult {
  passed
  rejected
  not_used
}

enum ResponseAction {
  continued
  chose_option
  talk_to_someone
  dismissed
}

enum ConsoleRole {
  admin
  product
  compliance
  sharia
  viewer
}

enum ConsentMethod {
  in_app
  online_banking
  branch
  api
}

// ---------------------------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------------------------

model Bank {
  id                  String     @id
  name                String
  nameAr              String
  defaultLocale       Locale     @default(en)
  supportedLocales    Locale[]
  /// Brand tokens for the widget's CSS custom properties, e.g. {"primary":"#7a1f3d"}
  brandTokens         Json
  /// e.g. "ddb://" (options are deep links, AMIL never executes: non-negotiable 3)
  deepLinkScheme      String
  digitStyle          DigitStyle @default(latn)
  /// {"card.close":{"criticalAtQar":"250.00","cautionAtQar":"50.00"}, ...} (strings)
  severityThresholds  Json
  modelMode           ModelMode  @default(redacted)
  currency            String     @default("QAR")
  auditRetentionYears Int        @default(10)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  customers     Customer[]
  feeSchedules  FeeSchedule[]
  rulePacks     RulePack[]
  templates     Template[]
  insightEvents InsightEvent[]
  proactiveJobs ProactiveJob[]
  consoleUsers  ConsoleUser[]
  approvalLogs  ApprovalLog[]
  inboundEvents InboundEvent[]

  @@map("bank")
}

// ---------------------------------------------------------------------------------------------
// Customer and consent
// ---------------------------------------------------------------------------------------------

model Customer {
  id              String   @id
  bankId          String
  /// The bank's own customer reference (what the bank sends as customerRef).
  externalRef     String
  /// PII
  displayName     String
  /// PII
  displayNameAr   String
  /// PII
  phone           String?
  /// PII
  email           String?
  preferredLocale Locale   @default(en)
  /// e.g. "mass", "affluent", "private"
  segment         String
  salaryTransfer  Boolean  @default(false)
  /// Demo-only persona key for the customer switcher (e.g. "khalid"). Null for non-personas.
  personaKey      String?
  createdAt       DateTime @default(now())

  bank     Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  consents Consent[]
  accounts Account[]
  cards    Card[]
  finances Finance[]
  deposits Deposit[]
  alerts   Alert[]

  @@unique([bankId, externalRef])
  @@unique([bankId, personaKey])
  @@map("customer")
}

model Consent {
  id                   String        @id @default(cuid())
  customerId           String
  /// e.g. "pre_decision_insights", "proactive_alerts", "assistant"
  purpose              String
  version              String
  method               ConsentMethod
  grantedAt            DateTime
  withdrawnAt          DateTime?
  privacyPolicyVersion String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
  @@map("consent")
}

// ---------------------------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------------------------

model Account {
  id                   String        @id
  customerId           String
  kind                 AccountKind
  variant              Variant       @default(conventional)
  productName          String
  /// PII (synthetic)
  number               String
  /// PII (synthetic)
  iban                 String
  currency             String        @default("QAR")
  balance              Decimal       @db.Decimal(18, 2)
  status               AccountStatus @default(active)
  isSalaryAccount      Boolean       @default(false)
  openedAt             DateTime
  lastActivityAt       DateTime
  /// Days of customer-initiated inactivity after which this account becomes dormant.
  dormancyDays         Int           @default(365)
  closureFee           Decimal       @db.Decimal(18, 2)
  chequesOutstanding   Int           @default(0)
  /// Monthly maintenance fee when not waived (synthetic).
  maintenanceFee       Decimal       @default(0) @db.Decimal(18, 2)
  maintenanceFeeWaived Boolean       @default(false)

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  standingOrders StandingOrder[]
  transactions   Transaction[]
  cards          Card[]          @relation("CardSettlementAccount")

  @@index([customerId])
  @@map("account")
}

model StandingOrder {
  id        String   @id
  accountId String
  payee     String
  amount    Decimal  @db.Decimal(18, 2)
  /// "monthly" | "quarterly"
  frequency String
  nextRunAt DateTime
  active    Boolean  @default(true)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("standing_order")
}

model Card {
  id                      String     @id
  customerId              String
  settlementAccountId     String?
  type                    Variant
  tier                    CardTier
  productName             String
  /// PII (synthetic test-range PAN, deliberately not Luhn-valid)
  pan                     String
  panLast4                String
  creditLimit             Decimal    @db.Decimal(18, 2)
  /// Current outstanding balance (posted + unbilled)
  balance                 Decimal    @db.Decimal(18, 2)
  statementBalance        Decimal    @db.Decimal(18, 2)
  minDue                  Decimal    @db.Decimal(18, 2)
  paymentDueAt            DateTime
  /// Interest APR (conventional) or profit rate (Islamic), annual percent
  profitOrInterestRateApr Decimal    @db.Decimal(9, 4)
  cashAdvanceFeePct       Decimal    @db.Decimal(9, 4)
  cashAdvanceMinFee       Decimal    @db.Decimal(18, 2)
  annualFee               Decimal    @db.Decimal(18, 2)
  annualFeeChargedAt      DateTime?
  annualFeeWaived         Boolean    @default(false)
  /// {"type":"pro_rata_months"|"none", "withinMonths":"12"}
  feeRefundRule           Json
  status                  CardStatus @default(active)
  supplementaryCount      Int        @default(0)
  openedAt                DateTime

  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  settlementAccount Account?         @relation("CardSettlementAccount", fields: [settlementAccountId], references: [id])
  rewards           RewardsLedger?
  instalmentPlans   InstalmentPlan[]
  transactions      Transaction[]

  @@index([customerId])
  @@map("card")
}

model RewardsLedger {
  id              String   @id
  cardId          String   @unique
  /// Points balance
  balance         Int
  /// QAR value of one point, e.g. 0.0100
  pointValueQar   Decimal  @db.Decimal(10, 4)
  /// [{"points": 8000, "expiresAt": "2026-11-14"}]; buckets sum to balance
  expiryBuckets   Json
  pendingCashback Decimal  @default(0) @db.Decimal(18, 2)
  asOf            DateTime

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("rewards_ledger")
}

model InstalmentPlan {
  id                  String        @id
  cardId              String
  description         String
  originalAmount      Decimal       @db.Decimal(18, 2)
  principalRemaining  Decimal       @db.Decimal(18, 2)
  monthsRemaining     Int
  monthlyAmount       Decimal       @db.Decimal(18, 2)
  /// {"type":"pct_of_remaining","pct":"2.00","min":"50.00"}
  earlyClosureFeeRule Json
  startedAt           DateTime
  status              ProductStatus @default(active)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("instalment_plan")
}

model Finance {
  id                   String        @id
  customerId           String
  type                 FinanceType
  productName          String
  /// Original financed amount (principal / cost price)
  originalPrincipal    Decimal       @db.Decimal(18, 2)
  principalOutstanding Decimal       @db.Decimal(18, 2)
  /// Interest rate (conventional) or profit rate (Islamic), annual percent
  ratePct              Decimal       @db.Decimal(9, 4)
  tenorMonths          Int
  monthsElapsed        Int
  instalment           Decimal       @db.Decimal(18, 2)
  startAt              DateTime
  nextInstalmentAt     DateTime
  /// [{"n":1,"dueAt":"2026-01-15","principal":"...","profit":"...","instalment":"...","paid":true}]
  schedule             Json
  /// Conventional: {"type":"pct_of_outstanding","pct":"1.00","cap":"...","floor":"..."}
  settlementFeeRule    Json
  /// Islamic murabaha ibra policy, e.g. {"type":"ibra_tiers","tiers":[{"minMonthsElapsed":0,"pct":"50.00"}]}
  rebateRule           Json?
  /// {"kind":"insurance"|"takaful","premiumPaid":"1800.00","refundRule":{"type":"pro_rata_months"}}
  insuranceOrTakaful   Json?
  salaryLinked         Boolean       @default(false)
  status               ProductStatus @default(active)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("finance")
}

model Deposit {
  id                String        @id
  customerId        String
  variant           Variant
  productName       String
  principal         Decimal       @db.Decimal(18, 2)
  /// Fixed rate (conventional) or expected profit rate (Islamic), annual percent
  ratePct           Decimal       @db.Decimal(9, 4)
  startAt           DateTime
  maturityAt        DateTime
  /// {"type":"pct_of_principal","pct":"0.50","min":"100.00"}
  breakPenaltyRule  Json
  /// {"type":"reduced_rate","ratePct":"0.5000"} | {"type":"none"}
  profitOnBreakRule Json
  payoutAccountId   String?
  autoRenew         Boolean       @default(false)
  status            DepositStatus @default(active)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("deposit")
}

model Transaction {
  id        String       @id
  accountId String?
  cardId    String?
  /// Always positive; see direction
  amount    Decimal      @db.Decimal(18, 2)
  direction TxnDirection
  currency  String       @default("QAR")
  type      TxnType
  merchant  String?
  category  String?
  postedAt  DateTime
  /// Set for fee lines; maps to FeeSchedule.code (latest version effective at postedAt)
  feeCode   String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card    Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([accountId, postedAt])
  @@index([cardId, postedAt])
  @@index([feeCode])
  @@map("transaction")
}

model FeeSchedule {
  id            String   @id @default(cuid())
  bankId        String
  code          String
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  avoidTipEn    String
  avoidTipAr    String
  /// {"type":"fixed","amount":"25.00"} | {"type":"pct","pct":"3.00","min":"60.00"}
  amountRule    Json
  version       Int      @default(1)
  effectiveFrom DateTime

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, code, version])
  @@map("fee_schedule")
}

// ---------------------------------------------------------------------------------------------
// Rules and copy (bank-managed through the console)
// ---------------------------------------------------------------------------------------------

model RulePack {
  id            String         @id @default(cuid())
  bankId        String
  key           String
  version       String
  variant       Variant
  productFamily String
  status        RulePackStatus @default(draft)
  /// Kill switch (non-negotiable 9)
  enabled       Boolean        @default(true)
  /// Pack parameters; money/rates as strings
  parameters    Json
  effectiveFrom DateTime
  createdAt     DateTime       @default(now())
  createdBy     String?

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, key, variant, version])
  @@map("rule_pack")
}

model Template {
  id          String         @id @default(cuid())
  bankId      String
  key         String
  rulePackKey String
  variant     Variant
  locale      Locale
  severity    Severity
  headline    String
  body        String
  /// [{"key":"redeem_points","label":"Redeem points first"}] ordered: avoid-the-loss first
  options     Json
  status      TemplateStatus @default(draft)
  version     Int            @default(1)
  approvedBy  String?
  approvedAt  DateTime?
  /// Kill switch (non-negotiable 9)
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, key, locale, severity, version])
  @@index([bankId, rulePackKey, variant, locale])
  @@map("template")
}

// ---------------------------------------------------------------------------------------------
// Audit (append-only, non-negotiable 7)
// ---------------------------------------------------------------------------------------------

model InsightEvent {
  id                String          @id @default(cuid())
  /// Monotonic order for the hash chain
  seq               BigInt          @unique @default(autoincrement())
  bankId            String
  occurredAt        DateTime        @default(now())
  /// e.g. "action:card.close" | "schedule:rewards.expiry" | "assistant"
  trigger           String
  /// HMAC-SHA256 of the bank's customerRef; never the raw ref
  customerRefHash   String
  rulePackKey       String
  rulePackVersion   String
  variant           Variant
  inputSnapshotHash String
  applicable        Boolean
  severity          Severity?
  facts             Json
  templateKey       String?
  templateVersion   Int?
  modelProvider     String?
  modelVersion      String?
  validatorResult   ValidatorResult
  locale            Locale
  /// Exactly what the customer was shown (headline, body, facts, options)
  shown             Json
  latencyMs         Int?
  retentionUntil    DateTime
  prevHash          String
  hash              String          @unique

  bank      Bank               @relation(fields: [bankId], references: [id])
  responses CustomerResponse[]
  alerts    Alert[]

  @@index([bankId, customerRefHash, occurredAt])
  @@index([bankId, rulePackKey, occurredAt])
  @@map("insight_event")
}

model CustomerResponse {
  id             String         @id @default(cuid())
  insightEventId String
  action         ResponseAction
  optionKey      String?
  at             DateTime       @default(now())

  insightEvent InsightEvent @relation(fields: [insightEventId], references: [id])

  @@index([insightEventId])
  @@map("customer_response")
}

// ---------------------------------------------------------------------------------------------
// Proactive alerts and inbound events
// ---------------------------------------------------------------------------------------------

model Alert {
  id             String    @id @default(cuid())
  customerId     String
  insightEventId String?
  rulePackKey    String
  severity       Severity
  /// The same alert worded in each language the bank supports: {"en": "<insightEventId>", "ar": …}.
  /// insightEventId is the customer's preferred-language event.
  localeEventIds Json      @default("{}")
  /// Prevents duplicate alerts, e.g. "rewards.expiry:card_x:2026-11-14"
  dedupeKey      String
  createdAt      DateTime  @default(now())
  readAt         DateTime?
  dismissedAt    DateTime?

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  insightEvent InsightEvent? @relation(fields: [insightEventId], references: [id])

  @@unique([customerId, dedupeKey])
  @@map("alert")
}

model ProactiveJob {
  id          String    @id @default(cuid())
  bankId      String
  rulePackKey String
  /// cron expression
  schedule    String
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, rulePackKey])
  @@map("proactive_job")
}

model InboundEvent {
  id             String   @id @default(cuid())
  bankId         String
  idempotencyKey String
  type           String
  payload        Json
  receivedAt     DateTime @default(now())

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, idempotencyKey])
  @@map("inbound_event")
}

// ---------------------------------------------------------------------------------------------
// Console
// ---------------------------------------------------------------------------------------------

model ConsoleUser {
  id        String      @id
  bankId    String
  email     String
  name      String
  role      ConsoleRole
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  bank         Bank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  approvalLogs ApprovalLog[]

  @@unique([bankId, email])
  @@map("console_user")
}

model ApprovalLog {
  id         String   @id @default(cuid())
  bankId     String
  /// "template" | "rule_pack"
  entityType String
  entityId   String
  /// submitted | approved | sharia_approved | rejected | enabled | disabled | parameters_changed
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String
  comment    String?
  /// For parameter edits: {"before":{...},"after":{...}}
  diff       Json?
  at         DateTime @default(now())

  bank  Bank        @relation(fields: [bankId], references: [id], onDelete: Cascade)
  actor ConsoleUser @relation(fields: [actorId], references: [id])

  @@index([bankId, entityType, entityId])
  @@map("approval_log")
}
