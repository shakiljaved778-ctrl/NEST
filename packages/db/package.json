{
  "name": "@amil/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and synthetic seed for AMIL. Doha Demo Bank is fictional.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seed-data": "./src/seed/build.ts",
    "./adapters": "./src/adapters.ts",
    "./client": "./src/client.ts",
    "./pack-inputs": "./src/pack-inputs.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "dotenv -e ../../.env -- vitest run",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "audit:verify": "dotenv -e ../../.env -- tsx src/scripts/verify-audit.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@amil/rules-engine": "workspace:*",
    "@prisma/client": "~6.19.0",
    "@amil/rule-packs": "workspace:*",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@amil/gateway": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "prisma": "~6.19.0",
    "tsx": "^4.20.0"
  }
}
